# ==================================================
# KOTOBA - .gitignore
# ==================================================

# ------------------
# Python (build-time data pipeline only)
# ------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Graphify generated files
graphify-out/

# ------------------
# Node.js / Electron / Vite / Forge
# ------------------
node_modules/
dist/
dist-ssr/
out/
coverage/
.vite/
.npm/
*.tsbuildinfo

npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Keep package.json and package-lock.json tracked.

# ------------------
# Environment variables and secrets
# ------------------
.env
.env.*
!.env.example
!.env.*.example

*.pem
*.key
*.p12
*.pfx
*.crt
*credentials*.json
*secret-value*.txt
secrets.json
secrets/

# ------------------
# Generated data
# Tracked instead: data/manifest.json, data/curriculum/, data/fixtures/
# ------------------
data/raw/
data/processed/
resources/dictionaries/

# ------------------
# Local databases, backups and runtime data
# ------------------
backups/
tmp/
temp/
.cache/
logs/
*.log
*.db
*.sqlite
*.sqlite3
*-journal
*.db-wal
*.db-shm
*.sqlite-wal
*.sqlite-shm
*.sqlite3-wal
*.sqlite3-shm

# ------------------
# Local-only project spec
# ------------------
AGENTS.md

# ------------------
# IDE and OS
# ------------------
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo
*~
